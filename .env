# Environment Configuration
APP_NAME="PulseLink URL Shortener"
BASE_URL="http://localhost:8000"
DEBUG=true

# Database
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/urlshortener"
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_STREAM_KEY="clicks"
REDIS_CONSUMER_GROUP="click_workers"
REDIS_CONSUMER_NAME="worker-1"

# Security & Privacy Salt (for IP hashing)
SECRET_SALT="super-secret-salt-change-in-production-2026"

# Cache TTLs (seconds)
DEFAULT_CACHE_TTL=86400
NEGATIVE_CACHE_TTL=60
STAMPEDE_LOCK_TTL=5

# Rate Limits (requests per minute)
RATE_LIMIT_CREATE_PER_MIN=20
RATE_LIMIT_REDIRECT_PER_MIN=300

# Security & Access Control
ADMIN_API_KEY=""  # If non-empty, required for DELETE operations (via X-API-Key or Bearer token)
TRUSTED_PROXIES=["127.0.0.1","::1"]
TRUST_ALL_PROXIES=false
CORS_ORIGINS=["*"]
MAX_STATS_RANGE_DAYS=365
